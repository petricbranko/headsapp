# ---------------------------------------------------------------------------
# HeadsApp configuration. Copy to .env (production) or .env.local (dev).
# Local dev needs NONE of these: dev login and local-mode Telegram
# (messages shown in the app) are used automatically when a value is missing.
# ---------------------------------------------------------------------------

# Public URL and domain (production)
APP_BASE_URL=https://app.example.com
DOMAIN=app.example.com

# Auth0 (Regular Web Application). Callback: $APP_BASE_URL/auth/callback, Logout URL: $APP_BASE_URL
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# openssl rand -hex 32
AUTH0_SECRET=

# Used to sign internal tokens. openssl rand -hex 32
SESSION_SECRET=

# Telegram bot token from @BotFather (/newbot). One app instance per token.
TELEGRAM_BOT_TOKEN=

# Optional: AI summaries + news relevance check via OpenRouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5

# Optional: raises GitHub advisory API limits from 60 to 5000 req/h (no scopes needed)
GITHUB_TOKEN=

# Tuning
INGEST_INTERVAL_MINUTES=15
MAX_ALERTS_PER_DAY=5
